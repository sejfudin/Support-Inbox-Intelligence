# .env.development
# Local development environment file for the backend (server/).

# ── App config ──
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# ── Database — points at the SHARED dev database (taskmanager_dev), NOT prod ──
MONGODB_URI=

# ── Auth secrets — use DEV-only values, different from prod ──
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Supabase (storage) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ATTACHMENT_BUCKET=
SUPABASE_BUCKET_VISIBILITY=
SUPABASE_WORKSPACE_LOGO_BUCKET=
# Profile pictures. Must be a PUBLIC bucket permitting image/jpeg, image/png and
# image/webp — do NOT point this at the workspace-logo bucket, which caps objects
# at 1MB and disallows WEBP, so valid uploads come back as 502s.
SUPABASE_PROFILE_BUCKET=

# ── Groq (AI inference) ──
GROQ_API_KEY=
GROQ_MODEL=
GROQ_URL=
GROQ_TIMEOUT_MS=

# ── GitHub App integration ──
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_PRIVATE_KEY=
GITHUB_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=